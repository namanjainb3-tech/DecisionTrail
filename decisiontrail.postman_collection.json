{
  "info": {
    "name": "DecisionTrail API",
    "description": "Postman Collection for DecisionTrail Hackathon System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ingest GitHub Repository",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"repo\": \"astral-sh/uv\",\n  \"limit\": 20\n}"
        },
        "url": {
          "raw": "http://localhost:8000/ingest/github",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["ingest", "github"]
        }
      }
    },
    {
      "name": "2. Analyze PR for Regressions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"repo\": \"psf/black\",\n  \"changed_files\": [\"src/black/linegen.py\"],\n  \"pr_title\": \"Set default line length to 79 characters\",\n  \"threshold\": 0.2\n}"
        },
        "url": {
          "raw": "http://localhost:8000/pr/analyze",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["pr", "analyze"]
        }
      }
    },
    {
      "name": "3. List Decisions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/decisions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["decisions"]
        }
      }
    },
    {
      "name": "4. Get Knowledge Graph",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/graph?depth=2",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["graph"],
          "query": [
            {
              "key": "depth",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "5. Graph Diagnostics & Status",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/graph/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["graph", "status"]
        }
      }
    },
    {
      "name": "6. Evaluation Results",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8000/eval/results",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["eval", "results"]
        }
      }
    }
  ]
}

